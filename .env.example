# Google Maps browser API key. Enable Maps JavaScript API, Places API,
# Places API (New), and Routes API, then restrict the key to your website
# domains and those APIs.
VITE_GOOGLE_MAPS_API_KEY=

# Use DEMO_MAP_ID locally, or replace it with your own JavaScript Map ID
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Cloudflare Turnstile site key shown in the browser. The value below is
# Cloudflare's official always-pass test key for local development only.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
