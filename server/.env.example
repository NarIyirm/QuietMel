# Supabase project URL from Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the new publishable key, or set SUPABASE_ANON_KEY for a legacy project.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Server only. Use the new secret key, or set the legacy service-role key.
# Never expose either value through a VITE_ variable.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
CLIENT_ORIGINS=http://localhost:5173

# Keep false until Cloudflare Turnstile is configured in Supabase Auth.
AUTH_CAPTCHA_REQUIRED=false

# Optional confirmation redirect used in Supabase registration emails.
AUTH_EMAIL_REDIRECT_URL=http://localhost:5173
